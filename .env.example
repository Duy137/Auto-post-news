# =================================================================
# AUTO-POST-NEWS ENVIRONMENT CONFIGURATION TEMPLATE (V2 / V5.2)
# =================================================================

# -----------------------------------------------------------------
# 1. ORCHESTRATION & TIMING CONTROLS
# -----------------------------------------------------------------
RSS_ENABLED=True
EXPRESS_ENABLED=True

# Pipeline intervals (in minutes)
# Default for V2: Content Pipeline runs every 120m, Publisher checks every 5m
CONTENT_PIPELINE_INTERVAL=120
PUBLISH_CHECK_INTERVAL=5
QUEUE_MAX_AGE_HOURS=6

# Express Lane Controls
EXPRESS_THROTTLE_MINUTES=3
FINGERPRINT_WINDOW_MINUTES=60
RSS_PENALTY_MULTIPLIER=0.1
EXPRESS_RETRY_ATTEMPTS=2
EXPRESS_RETRY_BACKOFF_SEC=30

# -----------------------------------------------------------------
# 2. PER-PLATFORM PUBLISHING TIMING MODES
# Modes: "gap" (check last channel message), "scheduled" (fixed hours), "interval" (every N hours)
# -----------------------------------------------------------------
# Telegram (Default: Gap mode with 1-hour minimum cadence)
TG_PUBLISH_MODE=gap
TG_MIN_GAP_HOURS=1
TG_GAP_CHANNEL_ID=-100xxxxxxxxxx
TG_SCHEDULE=07:00,11:00,15:00,18:00,21:00,00:00
TG_INTERVAL_HOURS=4

# Twitter / X
TW_PUBLISH_MODE=scheduled
TW_MIN_GAP_HOURS=4
TW_SCHEDULE=07:00,11:00,15:00,18:00,21:00,00:00
TW_INTERVAL_HOURS=6

# Facebook
FB_PUBLISH_MODE=scheduled
FB_MIN_GAP_HOURS=4
FB_SCHEDULE=07:00,11:00,15:00,18:00,21:00,00:00
FB_INTERVAL_HOURS=6

# -----------------------------------------------------------------
# 3. LLM API CONFIGURATION & CROSS-PROVIDER ROUTING
# Active Provider: "openai" or "gemini"
# -----------------------------------------------------------------
LLM_PROVIDER=openai

# Optional: Toggle Stage 2 Vietnamese Polish pass (True / False)
POLISH_ENABLED=False

# OpenAI API Keys (For models: gpt-4o-mini, gpt-4o, etc.)
OPENAI_API_KEY=sk-...
OPENAI_API_KEY_1=sk-...
OPENAI_API_KEY_2=sk-...

# Google Gemini API Keys (For models: gemini-2.5-flash, gemma-3-27b-it)
GEMINI_API_KEY=AIzaSy...
GEMINI_API_KEY_1=AIzaSy...
GEMINI_API_KEY_2=AIzaSy...

# -----------------------------------------------------------------
# 4. TELEGRAM API CREDENTIALS (Bot & Telethon User Client)
# -----------------------------------------------------------------
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=-100xxxxxxxxxx
TELEGRAM_CHAT_ID_RSS=-100xxxxxxxxxx
TELEGRAM_CHAT_ID_EXPRESS=-100xxxxxxxxxx

# Telethon API Settings (from https://my.telegram.org)
TG_API_ID=12345678
TG_API_HASH=0123456789abcdef0123456789abcdef
TG_PHONE=+84xxxxxxxxx
TG_SOURCE_CHANNEL=@SourceCryptoChannel
TG_STRING_SESSION=1BVtsOHIBu...

# -----------------------------------------------------------------
# 5. SOCIAL MEDIA API CREDENTIALS (Twitter / Facebook)
# -----------------------------------------------------------------
# Twitter / X API v2
TWITTER_API_KEY=your_consumer_key
TWITTER_API_SECRET=your_consumer_secret
TWITTER_ACCESS_TOKEN=your_access_token
TWITTER_ACCESS_SECRET=your_access_secret

# Facebook Graph API
FACEBOOK_PAGE_ID=100000000000000
FACEBOOK_PAGE_ACCESS_TOKEN=EAA...

# -----------------------------------------------------------------
# 6. ANNOUNCEMENT TARGET CHANNELS
# -----------------------------------------------------------------
TARGET_CHANNELS_TIN_1=-100xxxxxxxxxx
TARGET_CHANNELS_TIN_2=-100xxxxxxxxxx
TARGET_CHANNELS_TIN_3=-100xxxxxxxxxx
TARGET_CHANNELS_TIN_4=-100xxxxxxxxxx
